{
  "name": "echo-api-proxy",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node server.mjs",
    "check": "node --check server.mjs",
    "check:smoke": "node --check scripts/smoke-deploy.mjs",
    "check:token": "node --check scripts/issue-session-token.mjs",
    "issue:session-token": "node scripts/issue-session-token.mjs",
    "smoke:deploy": "node scripts/smoke-deploy.mjs",
    "test": "node --test server.test.mjs",
    "verify": "npm run check && npm run check:smoke && npm run check:token && npm run test"
  }
}
