{
  "name": "echo-app",
  "private": true,
  "version": "0.1.8",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "sync-version": "node scripts/sync-version.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "build": "npm run sync-version && npm run typecheck && vite build",
    "preview": "vite preview",
    "sim": "npx evenhub-simulator http://localhost:5173",
    "pack": "npm run sync-version && npx evenhub pack app.json dist -o echo.ehpk",
    "verify": "npm run test && npm run build && npm run pack"
  },
  "dependencies": {
    "@evenrealities/even_hub_sdk": "0.0.10",
    "@evenrealities/evenhub-simulator": "0.7.3",
    "@evenrealities/evenhub-cli": "0.1.13",
    "@ricky0123/vad-web": "^0.0.20",
    "idb-keyval": "^6.2.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "~5.4.0",
    "vite": "^6.0.0",
    "vite-plugin-static-copy": "^2.0.0",
    "vitest": "^2.1.9"
  }
}
